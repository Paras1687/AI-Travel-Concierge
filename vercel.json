{
  "buildCommand": "cd Travel-app-UI && npm install && npm run build",
  "outputDirectory": "Travel-app-UI/dist",
  "rewrites": [
    {
      "source": "/api/plan",
      "destination": "/api/plan.py"
    },
    {
      "source": "/((?!api/|.*\\.|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
