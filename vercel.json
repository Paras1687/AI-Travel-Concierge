{
  "version": 2,
  "builds": [
    {
      "src": "Travel-app-UI/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/plan.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/plan",
      "dest": "api/plan.py"
    },
    {
      "src": "/(.*)",
      "dest": "Travel-app-UI/$1"
    }
  ]
}
